# ─── Server Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your real values. NEVER commit .env to git.

PORT=4000
NODE_ENV=development

# REQUIRED: Long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gigcampus

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
